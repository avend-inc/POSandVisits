# このファイルをコピーして「.env」という名前で保存し、
# 右側にご自分のユーザー名とパスワードを書いてください。
#
#   コピーの仕方（PowerShell）:
#     Copy-Item .env.example .env
#
# ⚠️ .env は .gitignore 済みなので、GitHubには上がりません。
# ⚠️ このファイル（.env.example）には本物を書かないでください。
#
# GitHub Actions で自動実行するときは、.env ではなく
# リポジトリの「Secrets」に同じ名前で登録します（README.md 参照）。

# ------------------------------------------------------------
# デジテールストア https://dashboard.digitail-tech.com/auth/login
# ※メールアドレスではなく「ユーザー名」です
# ------------------------------------------------------------
DIGITAIL_ID=ここにユーザー名
DIGITAIL_PW=ここにパスワード

# ------------------------------------------------------------
# cashier（キャッシャー） https://cashier.jp/v2/client/trade
# ※こちらはメールアドレスです
# ------------------------------------------------------------
CASHIER_ID=admin@avend.co.jp
CASHIER_PW=ここにパスワード

# ------------------------------------------------------------
# Supabase（データの保存先）
# SUPABASE_SERVICE_KEY は
#   Supabase管理画面 → Project Settings → API Keys → service_role
# の長い文字列です。強い権限を持つので絶対に公開しないでください。
# ------------------------------------------------------------
SUPABASE_URL=https://rwfcsanmqvkxiuwdeddv.supabase.co
SUPABASE_SERVICE_KEY=ここにservice_roleキー

# ------------------------------------------------------------
# （任意）cashier の画面が変わったときの調整用。
# 普段は空のままで構いません。
# ------------------------------------------------------------
# CASHIER_DATE_FROM_SELECTOR=
# CASHIER_DATE_TO_SELECTOR=
# CASHIER_SEARCH_SELECTOR=
# CASHIER_CSV_SELECTOR=
